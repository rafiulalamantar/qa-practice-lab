APP_NAME="QA Practice Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qa_practice_lab
DB_USERNAME=qa_lab
DB_PASSWORD=
# Required by TLS-only cloud MySQL (TiDB Cloud, Aiven). On Vercel use:
# MYSQL_ATTR_SSL_CA=/etc/pki/tls/certs/ca-bundle.crt
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- QA Practice Lab ---
SANCTUM_EXPIRATION=1440
PRACTICE_DEMO_EMAIL=demo@practice.test
PRACTICE_DEMO_PASSWORD=Demo@1234
PRACTICE_CHAOS_MIN_MS=300
PRACTICE_CHAOS_MAX_MS=2500
PRACTICE_ORDER_RETENTION_DAYS=7
PRACTICE_INACTIVE_USER_DAYS=30
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/prune
CRON_SECRET=
